with Ada.Streams;
with Interfaces;
with Util.Encoders.ChaCha20;

--  === Secure random generator ===
--  The `Util.Encoders.Random.Secure` generic package transforms a basic random
--  generator into a cryptographically secure random generator, similar to
--  `arc4random` on recent NetBSD: a ChaCha20 stream cipher (RFC 8439) is seeded
--  with a fresh key and nonce drawn from the underlying <b>Random_Generator</b>,
--  and the generated bytes are the ChaCha20 keystream.  As long as the key is
--  not reused, the output is indistinguishable from random even if the
--  underlying generator is weak.
--
--    package Secure_Random is
--      new Util.Encoders.Random.Secure
--        (Random_Generator => Util.Encoders.Random.Xsorshiftr.Xorshiftr_Generator);
--
--    Gen : Secure_Random.Secure_Generator;
--    ...
--    Gen.Generate (Buf);
generic
   type Random_Generator is limited new Generator with private;
package Util.Encoders.Random.Secure with Preelaborate is

   --  A cryptographically secure random generator.  It is safe to share it
   --  between several tasks when wrapped in a protected type.
   type Secure_Generator is limited new Util.Encoders.Random.Generator with private;

   --  Reseed the generator: draw a fresh ChaCha20 key and nonce from the
   --  underlying random generator and reset the block counter.  The generator
   --  is reseeded automatically on the first `Generate` call and when the
   --  block counter is about to wrap.
   procedure Reseed (Gen : in out Secure_Generator);

   --  Fill the array with cryptographically secure random bytes.
   overriding
   procedure Generate (Gen  : in out Secure_Generator;
                       Into : out Ada.Streams.Stream_Element_Array);

private

   type Secure_Generator is limited new Util.Encoders.Random.Generator with record
      Rand    : Random_Generator;
      Key     : Util.Encoders.ChaCha20.Key;
      Nonce   : Util.Encoders.ChaCha20.Nonce;
      Counter : Interfaces.Unsigned_32 := 0;
      Seeded  : Boolean := False;
   end record;

end Util.Encoders.Random.Secure;
